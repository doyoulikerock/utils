#!/usr/bin/env bash
# Bing 오늘의 이미지를 받아 GNOME 배경화면/잠금화면으로 설정
# 사용법:
#   bing-wallpaper                  가장 최근 이미지 적용 (고정 상태면 아무것도 안 함)
#                                   고정은 재부팅 전까지만 유지, 오프라인이면 받아둔 최신 이미지 사용
#   bing-wallpaper --list           최근 ~16일 이미지 목록 (* = 현재 배경화면)
#   bing-wallpaper --pick [N]       목록에서 번호로 골라 적용 + 고정 (N 생략 시 입력받음, 터미널 없으면 zenity 창)
#   bing-wallpaper --search 단어    설명/이름에 단어가 포함된 최근 이미지 적용 + 고정
#   bing-wallpaper --date YYYYMMDD  해당 날짜 이미지 적용 + 고정
#   bing-wallpaper --idx N          N일 전 이미지 적용 + 고정
#   bing-wallpaper --unpin          고정 해제 후 오늘 이미지로 복귀
#   --force                         다시 다운로드/재적용
set -euo pipefail

MKT="${BING_MKT:-ko-KR}"
DIR="${BING_DIR:-$HOME/Pictures/BingWallpaper}"
PIN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/bing-wallpaper/pinned"
KEEP="${BING_KEEP:-7}"          # 보관할 이미지 수 (날짜 기준 최신 N장)
RETRIES="${BING_RETRIES:-12}"   # 네트워크 대기: 12회 x 10초 = 최대 2분
FORCE=0
MODE=today
ARG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE=1 ;;
    --idx) MODE=idx; ARG="$2"; shift ;;
    --date) MODE=date; ARG="$2"; shift ;;
    --search) MODE=search; ARG="$2"; shift ;;
    --list) MODE=list ;;
    --pick) MODE=pick
            if [[ "${2:-}" =~ ^[0-9]+$ ]]; then ARG="$2"; shift; fi ;;
    --unpin) MODE=unpin ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

export TZ=Asia/Seoul
mkdir -p "$DIR"

log() { echo "[bing-wallpaper] $*"; }

BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)

apply_wallpaper() {   # $1 = 이미지 파일, $2 = 설명
  local uri="file://$1" current
  current=$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null || true)
  if [[ "$current" == "'$uri'" && $FORCE -eq 0 ]]; then
    log "wallpaper already up to date"
    return 0
  fi
  gsettings set org.gnome.desktop.background picture-options 'zoom'
  gsettings set org.gnome.desktop.background picture-uri "$uri"
  gsettings set org.gnome.desktop.background picture-uri-dark "$uri" 2>/dev/null || true
  gsettings set org.gnome.desktop.screensaver picture-uri "$uri" 2>/dev/null || true
  log "wallpaper set: ${2:-$(basename "$1")}"
  if command -v notify-send >/dev/null && [[ -n "${2:-}" ]]; then
    notify-send -i preferences-desktop-wallpaper "Bing 배경화면" "$2" 2>/dev/null || true
  fi
}

# 고정 파일: 1행 = 이미지 파일명, 2행 = 고정한 부팅의 boot_id
if [[ $MODE == unpin ]]; then
  rm -f "$PIN_FILE"; log "unpinned"; MODE=today
elif [[ $MODE == today && -f "$PIN_FILE" && $FORCE -eq 0 ]]; then
  pin_name=$(sed -n 1p "$PIN_FILE"); pin_boot=$(sed -n 2p "$PIN_FILE")
  if [[ "$pin_boot" == "$BOOT_ID" ]]; then
    log "pinned to $pin_name — skip (use --unpin to resume daily updates)"
    exit 0
  fi
  rm -f "$PIN_FILE"
  log "rebooted since pinning $pin_name — pin cleared, using latest image"
fi

# 최근 이미지 아카이브 (API는 idx 0~7, n 최대 8 → 두 번 호출로 ~16일치)
fetch_archive() {
  local a b
  a=$(curl -fsS --max-time 20 "https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=8&mkt=${MKT}") || return 1
  [[ $MODE == today ]] && { jq -c '.images' <<<"$a"; return 0; }
  b=$(curl -fsS --max-time 20 "https://www.bing.com/HPImageArchive.aspx?format=js&idx=7&n=8&mkt=${MKT}") || b='{"images":[]}'
  jq -cs '[.[].images[]] | unique_by(.startdate) | sort_by(.startdate) | reverse' <(echo "$a") <(echo "$b")
}

images=""
for ((i = 1; i <= RETRIES; i++)); do
  if images=$(fetch_archive) && [[ -n "$images" && "$images" != "[]" ]]; then break; fi
  images=""
  log "network not ready, retry $i/$RETRIES"
  sleep 10
done
if [[ -z "$images" ]]; then
  log "failed to fetch metadata"
  # 오프라인: 받아둔 이미지 중 가장 최근 것(파일명 YYYYMMDD 기준)으로 설정
  latest=$(find "$DIR" -maxdepth 1 -name '[0-9]*_*.jpg' -printf '%f\n' | sort -r | head -n1)
  if [[ $MODE == today && -n "$latest" ]]; then
    log "offline — using latest local image $latest"
    apply_wallpaper "$DIR/$latest"
    exit 0   # 다음 매시 실행에서 온라인이면 다시 확인
  fi
  exit 1
fi

cur=$(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null | sed -E "s|.*/([0-9]{8})_.*|\1|" || true)

print_list() {
  jq -r --arg cur "$cur" 'to_entries[] |
    "\(if .value.startdate == $cur then "*" else " " end) \(.key)\t\(.value.startdate)\t\(.value.copyright)"' <<<"$images"
}

if [[ $MODE == list ]]; then
  print_list
  exit 0
fi

if [[ $MODE == pick ]]; then
  count=$(jq length <<<"$images")
  if [[ -n "$ARG" ]]; then
    :   # --pick N: 번호를 바로 지정
  elif [[ -t 0 ]]; then
    print_list
    echo "  (* = 현재 배경화면)"
    read -rp "번호 선택 [0-$((count - 1))], u=고정 해제, Enter=취소: " ARG
    [[ -z "$ARG" ]] && exit 0
    if [[ "$ARG" == u ]]; then exec "$0" --unpin; fi
  elif command -v zenity >/dev/null; then
    ARG=$(jq -r --arg cur "$cur" 'to_entries[] |
      (if .value.startdate == $cur then "TRUE" else "FALSE" end), "\(.key)", .value.startdate, .value.copyright' <<<"$images" |
      zenity --list --radiolist --title "Bing 배경화면 선택" --width 900 --height 560 \
        --column "" --column "#" --column "날짜" --column "설명" --print-column 2 2>/dev/null) || exit 0
    [[ -z "$ARG" ]] && exit 0
  else
    log "--pick needs a terminal or zenity"; exit 2
  fi
  [[ "$ARG" =~ ^[0-9]+$ && "$ARG" -lt "$count" ]] || { log "invalid choice: $ARG"; exit 2; }
  MODE=idx
fi

case $MODE in
  today)  sel=$(jq -c '.[0]' <<<"$images") ;;
  idx)    sel=$(jq -c --argjson n "$ARG" '.[$n] // empty' <<<"$images") ;;
  date)   sel=$(jq -c --arg d "$ARG" 'map(select(.startdate == $d)) | .[0] // empty' <<<"$images") ;;
  search) sel=$(jq -c --arg q "$ARG" 'map(select((.copyright + " " + .urlbase + " " + (.title // "")) | ascii_downcase | contains($q | ascii_downcase))) | .[0] // empty' <<<"$images") ;;
esac
[[ -n "${sel:-}" ]] || { log "no matching image for $MODE '$ARG' (see --list)"; exit 1; }

urlbase=$(jq -r '.urlbase' <<<"$sel")
startdate=$(jq -r '.startdate' <<<"$sel")
copyright=$(jq -r '.copyright // ""' <<<"$sel")
[[ -n "$urlbase" && "$urlbase" != null ]] || { log "invalid metadata"; exit 1; }

name=$(sed -E 's/.*OHR\.([^_]+).*/\1/' <<<"$urlbase")
file="$DIR/${startdate}_${name}.jpg"

download() {
  local res="$1" tmp
  tmp=$(mktemp "$DIR/.dl.XXXXXX")
  if curl -fsS --max-time 120 -o "$tmp" "https://www.bing.com${urlbase}_${res}.jpg" \
     && [[ $(stat -c %s "$tmp") -gt 50000 ]] \
     && [[ "$(head -c 3 "$tmp" | od -An -tx1 | tr -d ' ')" == "ffd8ff" ]]; then
    mv -f "$tmp" "$file"
    log "downloaded $res -> $file"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

if [[ -f "$file" && $FORCE -eq 0 ]]; then
  log "already have $file"
else
  download UHD || download 1920x1080 || { log "download failed"; exit 1; }
fi

if [[ $MODE != today ]]; then
  mkdir -p "$(dirname "$PIN_FILE")"
  printf '%s\n%s\n' "$(basename "$file")" "$BOOT_ID" > "$PIN_FILE"
  log "pinned until reboot (--unpin to resume daily updates now)"
fi

apply_wallpaper "$file" "$copyright"

# 오래된 이미지 정리: 날짜 기준 최신 $KEEP 장만 보관 (현재 배경화면은 항상 유지)
find "$DIR" -maxdepth 1 -name '[0-9]*_*.jpg' -printf '%f\n' | sort -r | tail -n +$((KEEP + 1)) |
  while IFS= read -r old; do
    [[ "$DIR/$old" == "$file" ]] && continue
    rm -f -- "$DIR/$old" && log "removed old image $old"
  done
